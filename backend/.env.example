# Server Environment Configuration
PORT=8080
NODE_ENV=production

# Database Connection (MongoDB URI)
mongoDB_URL=mongodb://localhost:27017/StayEase

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret

# Cloudinary (Media Uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Gemini AI Features (Property Description & Review Summarizer)
GEMINI_API_KEY=your_gemini_api_key

# Optional TripAdvisor / Google Places for live hotel data
RAPIDAPI_KEY=your_rapidapi_key
GOOGLE_PLACES_API_KEY=your_google_places_api_key
